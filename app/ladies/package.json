{
  "name": "salon-auto-poster",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:extension": "tsx scripts/build-extension.ts",
    "layout:sync": "tsx scripts/layout-sync.ts",
    "export:mac": "tsx scripts/export-mac.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/extension/tsconfig.json && tsc --noEmit -p tests/e2e/tsconfig.json && tsc --noEmit -p scripts/tsconfig.profile-check.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run --config tests/e2e/vitest.config.ts",
    "start": "node dist/src/cli.js start",
    "launch": "node dist/src/launcher.js",
    "dev": "tsx src/cli.ts start",
    "dry-run": "node dist/src/cli.js dry-run",
    "status": "node dist/src/cli.js status",
    "config:validate": "node dist/src/cli.js config:validate",
    "templates:import": "node dist/src/cli.js templates:import",
    "trends:refresh": "node dist/src/cli.js trends:refresh",
    "trends:web": "node dist/src/cli.js trends:web",
    "retry": "node dist/src/cli.js retry",
    "redraft": "node dist/src/cli.js redraft",
    "pause": "node dist/src/cli.js pause",
    "resume": "node dist/src/cli.js resume",
    "reconcile": "node dist/src/cli.js reconcile",
    "history:rebuild": "node dist/src/cli.js history:rebuild",
    "cleanup:preview": "node dist/src/cli.js cleanup:preview",
    "cleanup": "node dist/src/cli.js cleanup",
    "ai:smoke": "node dist/src/cli.js ai:smoke",
    "ai:test": "node dist/src/cli.js ai:test",
    "pair": "node dist/src/cli.js pair",
    "survey:list": "node dist/src/cli.js survey:list",
    "survey:show": "node dist/src/cli.js survey:show",
    "probe": "node dist/src/cli.js probe",
    "profile:check": "tsx scripts/profile-check.ts",
    "checks:record": "node dist/src/cli.js checks:record",
    "preflight": "node dist/src/cli.js preflight",
    "live:single": "node dist/src/cli.js live:single"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@google/genai": "^2.27.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "openai": "^7.28.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "0.3.4",
    "@types/node": "^24.19.1",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "jsdom": "30.1.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
