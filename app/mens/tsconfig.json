{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "tests", "scripts", "vitest.config.ts"],
  "exclude": ["apps", "tests/unit/extension", "tests/e2e", "scripts/profile-check.ts", "tests/unit/scripts/profile-check.test.ts"]
}
